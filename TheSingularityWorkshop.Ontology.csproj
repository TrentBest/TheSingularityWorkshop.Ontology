<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TheSingularityWorkshop.Ontology</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>TheSingularityWorkshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Independent ontology definitions, semantic addresses, relationships, and interoperable ontology composition.</Description>
    <PackageTags>ontology;semantic-address;microbundle;composition;knowledge-model</PackageTags>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.Ontology</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.Ontology</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Initial public ontology contracts with scalar and N-dimensional indexing, semantic addressing, relationships, and address-space mathematics.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" />
  </ItemGroup>
</Project>